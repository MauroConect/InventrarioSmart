APP_NAME="El Cristo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# Dominios “stateful” de Sanctum (SPA + cookie de sesión en /api/*). El host de cada petición y APP_URL se agregan en runtime;
# igual podés listar acá IPs o subdominios extra (ej. 192.168.0.10,mi.dominio.com).
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=inventario_db
DB_USERNAME=inventario_user
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
LOG_CHANNEL=stack
LOG_LEVEL=debug
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Fundación SaaS multitenant. Mantener true hasta migrar todas las tablas de negocio.
TENANCY_LEGACY_MODE=true
TENANCY_SESSION_KEY=tenant_id
TENANCY_HEADER=X-Tenant-Id
TENANCY_CACHE_PREFIX=tenant
TENANCY_STORAGE_ROOT=tenants
TENANCY_BASE_DOMAIN=inventariosmart.local
TENANCY_LEGACY_LOGIN_ENABLED=false

# Backfill de clientes sin referencias: definir un tenant existente sólo después
# de reconciliar su pertenencia si la base contiene varios comercios.
# TENANCY_CLIENT_BACKFILL_TENANT_ID=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS=soporte@inventariosmart.local
MAIL_FROM_NAME="InventarioSmart"

# Soporte IA (opcional: sin clave funciona con respuestas de fallback)
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Seeders opcionales: no se incluyen credenciales por defecto.
# PLATFORM_SUPERADMIN_NAME=
# PLATFORM_SUPERADMIN_EMAIL=
# PLATFORM_SUPERADMIN_PASSWORD=
# TENANCY_SEED_TENANT_NAME=
# TENANCY_SEED_TENANT_SLUG=
# TENANCY_SEED_RUBRO_PROFILE=base
# TENANCY_SEED_TIMEZONE=UTC
# TENANCY_SEED_ADMIN_NAME=
# TENANCY_SEED_ADMIN_EMAIL=
# TENANCY_SEED_ADMIN_PASSWORD=
